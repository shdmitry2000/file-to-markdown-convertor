{
  "description": "Project scenario/environment data for shared runtime verification. Producer input flags require final integration mapping; this file executes nothing.",
  "scenarios": "harness/END-TO-END.md",
  "holdout": ".factory/holdout/HOLDOUT.md",
  "driver": "http",
  "http": {
    "start": "uv run uvicorn app.api.main:app --host 127.0.0.1 --port $PORT",
    "health_path": "/health",
    "health_contains": "\"status\":\"healthy\"",
    "boot_timeout_s": 120,
    "env": {
      "MARKDOWN_EMBEDDED_WORKERS": "1",
      "PROJECTS_BASE_PATH": "$FACTORY_RUNTIME_STATE/projects",
      "CONVERTED_FILES_DIR": "$FACTORY_RUNTIME_STATE/converted"
    }
  },
  "cli": {
    "invoke": "",
    "smoke_args": "--version",
    "smoke_contains": ""
  },
  "library": {
    "import_check": ""
  },
  "browser": {
    "install_check": "",
    "install_hint": ""
  },
  "requirements": {
    "fresh_environment_per": [
      "runtime",
      "holdout",
      "retry",
      "mutation"
    ],
    "fresh_database": true,
    "assertion_evidence_required": true,
    "cleanup": "Owned process and environment cleanup must be verified by the producer"
  }
}
